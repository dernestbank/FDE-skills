{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fde-os.dev/schemas/workflow.schema.json",
  "title": "FDE Workflow",
  "type": "object",
  "required": ["workflow_id", "project_id", "name", "state", "trigger", "final_output", "steps"],
  "properties": {
    "workflow_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "state": {"enum": ["current", "future"]},
    "objective": {"type": "string"},
    "trigger": {"type": "string", "minLength": 1},
    "final_output": {"type": "string", "minLength": 1},
    "owner_id": {"type": ["string", "null"]},
    "frequency": {
      "type": "object",
      "properties": {"count": {"type": "number", "minimum": 0}, "period": {"type": "string"}},
      "additionalProperties": false
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step_id", "sequence", "name", "inputs", "outputs", "failure_modes", "exception_ids", "evidence_refs", "confidence"],
        "properties": {
          "step_id": {"type": "string"},
          "sequence": {"type": "integer", "minimum": 1},
          "name": {"type": "string"},
          "owner_id": {"type": ["string", "null"]},
          "actor_type": {"enum": ["human", "system", "hybrid"]},
          "system_ids": {"type": "array", "items": {"type": "string"}},
          "inputs": {"type": "array", "items": {"type": "string"}},
          "action": {"type": "string"},
          "decision_required": {"type": "boolean"},
          "outputs": {"type": "array", "items": {"type": "string"}},
          "handling_time_minutes": {"type": ["number", "null"], "minimum": 0},
          "waiting_time_minutes": {"type": ["number", "null"], "minimum": 0},
          "frequency_per_period": {"type": ["number", "null"], "minimum": 0},
          "failure_modes": {"type": "array", "items": {"type": "string"}},
          "exception_ids": {"type": "array", "items": {"type": "string"}},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "execution_type": {"enum": ["HUMAN_ONLY", "DETERMINISTIC_RULE", "API_CALL", "DATABASE_OPERATION", "RPA_ACTION", "LLM_ASSIST", "LLM_DECISION", "AGENT_ACTION", "HUMAN_APPROVAL", "HUMAN_EXCEPTION", "NO_LONGER_REQUIRED"]}
        },
        "additionalProperties": false
      }
    },
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "additionalProperties": false
}
