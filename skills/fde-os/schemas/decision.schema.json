{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fde-os.local/schemas/decision.schema.json",
  "title": "FDE Decision Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "date",
    "owner",
    "decision",
    "alternatives",
    "evidence_ids",
    "assumptions",
    "risks",
    "status"
  ],
  "properties": {
    "decision_id": {"type": "string", "minLength": 1},
    "date": {"type": "string", "format": "date"},
    "owner": {"type": "string", "minLength": 1},
    "decision": {"type": "string", "minLength": 1},
    "alternatives": {
      "type": "array",
      "items": {"type": "string"}
    },
    "evidence_ids": {
      "type": "array",
      "items": {"type": "string"}
    },
    "assumptions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "risks": {
      "type": "array",
      "items": {"type": "string"}
    },
    "consequences": {
      "type": "array",
      "items": {"type": "string"}
    },
    "reversal_trigger": {"type": "string"},
    "status": {
      "enum": ["proposed", "approved", "rejected", "superseded"]
    },
    "supersedes": {"type": ["string", "null"]}
  }
}
