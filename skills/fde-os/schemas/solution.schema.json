{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fde-os.local/schemas/solution.schema.json",
  "title": "FDE Compounded Solution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_contract",
    "status",
    "category",
    "created",
    "updated",
    "source_engagements",
    "tags",
    "problem_signature",
    "root_cause",
    "effective_intervention",
    "validation",
    "applicability",
    "contraindications"
  ],
  "properties": {
    "artifact_contract": {"const": "fde-solution/v1"},
    "status": {"enum": ["draft", "verified", "deprecated"]},
    "category": {
      "enum": [
        "workflow",
        "integration",
        "architecture",
        "evaluation",
        "security",
        "adoption",
        "deployment",
        "economics",
        "governance"
      ]
    },
    "created": {"type": "string", "format": "date"},
    "updated": {"type": "string", "format": "date"},
    "source_engagements": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "tags": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "problem_signature": {"type": "string", "minLength": 1},
    "root_cause": {"type": "string", "minLength": 1},
    "failed_approaches": {
      "type": "array",
      "items": {"type": "string"}
    },
    "effective_intervention": {"type": "string", "minLength": 1},
    "implementation_notes": {"type": "string"},
    "validation": {"type": "string", "minLength": 1},
    "applicability": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "contraindications": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "failure_signals": {
      "type": "array",
      "items": {"type": "string"}
    },
    "related_paths": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
